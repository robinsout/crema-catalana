{
  "name": "crema-catalana",
  "private": true,
  "type": "module",
  "description": "Quadern de català — lesson portal for the Passos 1 course",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "audio": "node scripts/gen-audio.ts",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:visual:update": "playwright test --grep @visual --update-snapshots=all",
    "icons": "node scripts/gen-icons.ts",
    "deploy:sync": "bash scripts/deploy-sync.sh"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "pinia": "^4.0.3",
    "uqr": "^0.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "yaml": "^2.9.1"
  }
}
