#!/bin/sh
# Runs the same checks as CI before anything reaches GitHub.
# Enable once per clone: git config core.hooksPath .githooks

# Use the Node version from .nvmrc when nvm is available
for f in "${NVM_DIR:-$HOME/.nvm}/nvm.sh" /usr/local/opt/nvm/nvm.sh /opt/homebrew/opt/nvm/nvm.sh; do
  if [ -s "$f" ]; then . "$f" && nvm use --silent >/dev/null 2>&1; break; fi
done

want=$(cat .nvmrc)
have=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)
if [ "$have" != "$want" ]; then
  echo "pre-push: Node $want required (.nvmrc), found ${have:-none}. Run: nvm install $want"
  exit 1
fi

echo "pre-push: npm run check (Node $(node --version))"
npm run check --silent || { echo "pre-push: checks failed, push aborted"; exit 1; }
